# agahi_hackathon configuration. Every value has a working default; copy to .env and edit.
# Admin dashboard password (CHANGE before showing to anyone)
ADMIN_PASSWORD=agahi-admin
# Secret used to sign admin cookies and CSRF tokens. If empty, a stable key is derived from ADMIN_PASSWORD,
# so every server instance agrees. Setting your own long random value is still better.
SECRET_KEY=
# Port for the web server
PORT=8000
# Training mode for first run and default Train button: fast | full
TRAIN_MODE=fast

# ---- SMS ----
# SMS provider: mock (default, simulated) | twilio | android_gateway
SMS_PROVIDER=mock
# Twilio: Account SID and Auth Token from the Twilio Console, number in E.164 form (+1..., +977...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public https address of this app, no trailing slash (e.g. https://agahi-demo.vercel.app).
# Twilio signs requests with this exact address. If empty, X-Forwarded-Proto/Host are used.
PUBLIC_BASE_URL=
# Check that webhooks really come from your provider (keep true when live)
SMS_VERIFY_SIGNATURE=true
# HMAC secret for the Android gateway / mock webhooks (empty = not checked)
SMS_WEBHOOK_SECRET=
# Android SMS gateway app (free path)
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_TOKEN=
# Estimated cost per SMS segment in NPR (dashboard estimate only)
SMS_COST_PER_SEGMENT_NPR=0.5
# Country code added to local numbers without + (numbers starting with + are kept as they are)
DEFAULT_COUNTRY_CODE=977
# Rate limits per phone number (real SMS only)
RATE_PER_MIN=20
RATE_PER_DAY=200
# Token for POST /api/jobs/alerts from a scheduler: send header "Authorization: Bearer <token>"
ALERTS_TOKEN=

# ---- Daily data fetch ----
# Fetch new Kalimati days on the first request of each new Nepal day (1 = on, 0 = off)
AUTO_FETCH=1
# Token for GET/POST /api/jobs/fetch: send header "Authorization: Bearer <token>".
# On Vercel, set CRON_SECRET instead (or as well): Vercel Cron sends it in that header for you.
FETCH_TOKEN=

# ---- Storage ----
# Where the app writes its database. Default: ./data locally, /tmp/agahi/data on Vercel.
DATA_DIR=

# ---- Other ----
# Upload limit for the data ZIP (MB)
MAX_UPLOAD_MB=60
# Brand colour overrides (hex, optional)
BRAND_PRIMARY=
BRAND_ACCENT=
# Live weather (Open-Meteo, free, no key). 0 = always use past-years averages.
LIVE_WEATHER=1
